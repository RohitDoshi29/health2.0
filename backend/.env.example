# --- Application ---
APP_NAME=Heathify API
ENVIRONMENT=development

# --- Database ---
# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/heathify

# --- Gemini API ---
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=8

# --- USDA FoodData Central API ---
# Used by scripts/import_usda_foods.py to expand reference foods database.
# Free signup: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

